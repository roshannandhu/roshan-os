# Phase 2 server configuration — placeholders only; never commit real values.
NODE_ENV=development
CONTROLLER_BIND_HOST=127.0.0.1
CONTROLLER_PORT=3000
CONTROLLER_EXPOSURE_MODE=localhost
CONTROLLER_ALLOWED_CLIENT_IP=tablet-control-private-phone-address
CONTROLLER_SERVE_WEB=false
# Runtime authority used only for signed APK delivery. Production requires a
# credential-free HTTPS Tailscale origin; never derive this from a request Host header.
CONTROLLER_PUBLIC_ORIGIN=https://controller-name.tailnet-name.ts.net
# Required only for the temporary, IP-restricted Phase 3A LAN-validation mode.
CONTROLLER_ADMIN_PASSWORD=replace-with-a-20-character-or-longer-temporary-password
CONTROLLER_SESSION_SECRET=replace-with-a-random-32-character-or-longer-session-secret

# Read-only is deliberately opt-in. IP Webcam is required in real-readonly mode
# and optional as a fallback in Companion mode.
TABLET_ADAPTER_MODE=mock
TABLET_IP_WEBCAM_BASE_URL=http://tablet-private-address:8080
TABLET_TRANSPORT=trusted-lan
TABLET_REQUEST_TIMEOUT_MS=5000
TABLET_STREAM_MAX_RECONNECT_ATTEMPTS=3
# Optional: set both or neither. Generated by .local/setup-ipwebcam-auth.mjs — never commit real values.
TABLET_IP_WEBCAM_USERNAME=
TABLET_IP_WEBCAM_PASSWORD=

# Direct-network service URLs (no ADB forwarding required when set).
# In lan-validation mode these must be non-loopback (e.g. http://192.168.1.5:2323).
# Omit to fall back to ADB-forward localhost (TABLET_FULLY_REMOTE_PORT / TABLET_COMPANION_PORT).
TABLET_FULLY_BASE_URL=
TABLET_COMPANION_BASE_URL=http://tablet-private-address:8765

# Fully Kiosk Remote Admin password — never commit the real value.
TABLET_FULLY_ADMIN_PASSWORD=
# Companion agent shared secret — never commit the real value.
TABLET_COMPANION_SECRET=replace-with-companion-secret

# Fully values are optional rollback-only settings. Production display control
# uses the free Wall Tablet kiosk built into Companion.
